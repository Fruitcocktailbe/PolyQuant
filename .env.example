# PolyQuant 2.0 Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env TO VERSION CONTROL. It contains sensitive private keys.

# =============================================================================
# API KEYS & SECRETS (The "Brains" and "Nerves")
# =============================================================================

# Default LLM Router API Key (recommended: OpenRouter for model routing)
# Used for Phase 1 (Discovery) and Phase 2 (Logic Architect) if using Gemini/OpenAI
# PolyQuant relies heavily on LLMs for Market Discovery & parsing natural language constraints.
# Get yours at: https://openrouter.ai/keys
GEMINI_API_KEY=sk-or-v1-9ea1c0d7...

# Alchemy API Key for Polygon blockchain interactions (reading & writing)
# Essential for low-latency Polymarket orderbook fetching and tx submission.
# Alchemy provides fast Remote Procedure Call (RPC) nodes for the Polygon blockchain.
# Get yours at: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your-alchemy-polygon-key

# Limitless API Key
# Authenticates requests to the Limitless.exchange API to access market data and execute trades there.
# Required for trading on Limitless.exchange.
# Get yours at: Reach out to Limitless team / Developer portal
LIMITLESS_API_KEY=lmts_...

# =============================================================================
# PRIVATE KEYS (DANGER: KEEP SECRET)
# =============================================================================

# Polygon Wallet Private Key (for Polymarket)
# The private key of the wallet holding your funds on the Polygon network.
# Used by the Rust OMS Sidecar to sign EIP-712 orders and submit trades.
# Format: 64-character hex string (with or without '0x' prefix)
# DANGER: Keep this absolutely secure!
POLYGON_PRIVATE_KEY=0x...

# Base Wallet Private Key (for Limitless)
# The private key of the wallet holding your funds on the Base network.
# Used to sign orders and approve USDC on the Base network.
# DANGER: Keep this absolutely secure!
BASE_PRIVATE_KEY=0x...

# =============================================================================
# NETWORK ENDPOINTS
# =============================================================================

# Polymarket (Polygon) URLs
# POLYMARKET_GAMMA_URL: Used primarily by the Map Maker to discover new events, fetch market metadata, and parse rules.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_URL: The critical Central Limit Order Book (CLOB) API for accessing raw bid/ask prices and submitting signed orders.
POLYMARKET_CLOB_URL=https://clob.polymarket.com
# POLYMARKET_DATA_URL: Used for fetching historical data, current portfolio positions, and past account activity.
POLYMARKET_DATA_URL=https://data-api.polymarket.com
# POLYMARKET_WS_URL: The WebSocket endpoint. Critical for subscribing to live orderbook updates so the bot doesn't have to poll for prices continuously.
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Limitless (Base) URLs
# LIMITLESS_API_URL: The core REST API endpoint for fetching Limitless data and submitting trades.
LIMITLESS_API_URL=https://api.limitless.exchange
# LIMITLESS_WS_URL: The Limitless WebSocket endpoint for streaming real-time price updates.
LIMITLESS_WS_URL=wss://stream.limitless.exchange
# BASE_RPC_URL: Standard RPC node for the Base network. Necessary for fetching on-chain balances (like USDC).
BASE_RPC_URL=https://mainnet.base.org

# =============================================================================
# SYSTEM CACHE
# =============================================================================

# Redis Connection URL
# Redis is the backbone of the system's state management. It caches SCIP optimization models to speed up repeat calculations, 
# stores transient orderbook data, and facilitates Inter-Process Communication (IPC) if Python and Rust need to sync state.
# Example: redis://localhost:6379/0 (default for local setups)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# TRADING ALGORITHM PARAMETERS (Execution & Safety)
# =============================================================================

# Extraction Alpha (0.0 to 1.0)
# Represents how aggressively the solver captures available arbitrage edges.
# 0.9 means we size to capture 90% of the mathematical limit. Leaving 10% on the table ensures executions fill rather than missing the trade squeezing margins.
EXTRACTION_ALPHA=0.9

# Kill Switch: Max Drawdown Threshold (0.0 to 1.0)
# Halts all trading if the portfolio loses this fraction of its peak capital.
# The Kill Switch trigger. For example, 0.15 equals 15%. If hit, the system hard-halts all operations and cancels pending orders.
MAX_DRAWDOWN=0.15

# Orderbook Depth Cap (0.0 to 1.0)
# Caps our maximum position size as a percentage of the available limit order depth.
# Prevents catastrophic slippage if we try to swallow the entire orderbook. (0.5 = 50%)
ORDERBOOK_DEPTH_CAP=0.5

# Dead Man's Switch: Max Websocket Age (ms)
# If websocket data is older than this (in milliseconds), trading halts for safety.
# A high value risks trading on stale prices, leading to bad entries.
WS_MAX_AGE_MS=200

# Order Expiration (Seconds)
# Time-to-Live (TTL) for submitted orders to prevent "ghost fills" if the blockchain stalls.
ORDER_EXPIRATION_SECONDS=6

# VWAP Slippage Limit
# The max tolerable difference in dollar amounts between expected execution price and worst-case fill.
VWAP_SLIPPAGE_LIMIT=0.05

# =============================================================================
# POSITION SIZING & RISK
# =============================================================================

# Sizing Strategy: 'kelly' or 'dutching'
# - 'kelly': Sizes individual directional trades based on calculated EV edge.
# - 'dutching': Groups mutually exclusive trades across exchanges to lock in risk-free profit.
SIZING_STRATEGY=dutching

# Kelly Fraction (0.01 to 1.0)
# Multiplier applied to the theoretical Kelly Criterion size. Controls bet sizing aggressiveness.
# 0.5 = Half Kelly (standard conservative setting).
KELLY_FRACTION=0.5

# Max Single Trade Limit (0.01 to 1.0)
# Hard cap on the maximum percentage of total capital risked on one arbitrage event. (0.05 = 5%)
MAX_SINGLE_TRADE_PCT=0.05

# Max Total Exposure (0.01 to 1.0)
# Hard cap on the total percentage of portfolio capital locked in active open trades combined. (0.25 = 25%)
MAX_TOTAL_EXPOSURE_PCT=0.25

# =============================================================================
# MARKET DISCOVERY (Map Maker)
# =============================================================================

# Minimum Event Liquidity (USD)
# Filters out low-volume, noisy markets during the scanning phase to save API and LLM costs.
MIN_LIQUIDITY=1000.0

# Zombie Price Thresholds
# If a market's price drops below LOW or goes above HIGH, it is ignored (resolved/dead market).
# Prevents trading on near-certain outcomes with no arb potential.
ZOMBIE_LOW_THRESHOLD=0.02
ZOMBIE_HIGH_THRESHOLD=0.98

# =============================================================================
# LLM & REASONING CONFIGURATION
# =============================================================================

# LLM Model Pinning (OpenRouter ID)
# Point to a specific model to ensure stability during large processing tasks.
# Default: openrouter/free (load-balanced free models)
# Recommended stable free model: google/gemini-2.0-flash-exp:free
LLM_MODEL=openrouter/free

# Agent Reasoning Temperature (0.0 to 2.0)
# Controls LLM creativity. Low for Logic Architect (needs strict math), higher if brainstorming.
# Standard config leans towards 0.0-0.3 for consistency in generating constraints.
LLM_TEMPERATURE=0.3

# Validator Confidence Threshold (0.0 to 1.0)
# The Phase 3 Validator must score the Architect's logic at or above this score
# for the trade constraints to be passed to the Rust Execution Sidecar.
VALIDATOR_CONFIDENCE_THRESHOLD=0.8

# =============================================================================
# SOLVER FINE-TUNING
# =============================================================================

# SCIP Solver Timeout (Seconds)
# Maximum time the SCIP integer programming solver is allowed to run before aborting.
SOLVER_TIMEOUT_SECONDS=30

# SCIP Optimality Gap
# The tolerance gap where the integer solver declares victory and stops searching for a better solution (e.g. within 1%).
SCIP_GAP=0.01

# Minimum Trade Size (USD)
# Rejects calculated arbitrage loops if the absolute bet size is smaller than this amount.
MIN_TRADE_SIZE=0.01

# INITIAL_EPSILON
# Initial contraction parameter for the Barrier Frank-Wolfe optimization algorithm. (0.1 is standard)
INITIAL_EPSILON=0.1

# FW_MAX_ITERATIONS
# Maximum iterations for Frank-Wolfe geometric descent before stopping.
FW_MAX_ITERATIONS=150

# FW_MIN_PROFIT
# Reject arbitrage loops if the projected net profit is below this dollar amount.
FW_MIN_PROFIT=0.50

# =============================================================================
# EXECUTION ROUTING
# =============================================================================

# Trading Mode: 'paper' (simulation) or 'live' (hits the real blockchain)
# In 'paper', Rust sidecar mock-submits orders and calculates paper PnL safely.
TRADING_MODE=paper

# Private RPC Gateway (Optional)
# If using bloXroute (BDN) or a private relay for PolyMarket for ultra-low latency, put the IP/Node-URL here.
# Overrides Alchemy for immediate execution.
PRIVATE_RPC_URL=

# =============================================================================
# SYSTEM LOGGING
# =============================================================================

# LOG_LEVEL: Standard Python logging levels (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# LOG_JSON: Set to true to output structured JSON logs, useful for production log aggregators (e.g., Datadog, ELK).
LOG_JSON=false

