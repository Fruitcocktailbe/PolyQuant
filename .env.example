# PolyQuant 2.0 Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API KEYS
# =============================================================================

# Google Gemini API Key (used for ALL AI operations: Discovery, Logic Architect, Validator)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# BLOCKCHAIN / DATA PROVIDERS
# =============================================================================

# Alchemy API Key (for Polygon blockchain data)
# Get yours at: https://www.alchemy.com/
ALCHEMY_API_KEY=your-alchemy-key-here

# Polygon Private Key (for EIP-712 signing and trade execution)
# WARNING: This is a sensitive secret. Never commit this to version control.
# Format: 0x followed by 64 hex characters
POLYGON_PRIVATE_KEY=

# Polymarket API endpoints
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# =============================================================================
# REDIS CACHE
# =============================================================================

REDIS_URL=redis://localhost:6379/0

# =============================================================================
# TRADING PARAMETERS
# =============================================================================

# Target extraction efficiency (0.0 to 1.0)
# How much of available arbitrage to capture (0.9 = 90%)
EXTRACTION_ALPHA=0.9

# Maximum drawdown before kill switch triggers (0.0 to 1.0)
MAX_DRAWDOWN=0.15

# Maximum position size as fraction of order book depth
ORDERBOOK_DEPTH_CAP=0.5

# Target latency in milliseconds
LATENCY_TARGET_MS=30

# VWAP slippage threshold in dollars
VWAP_SLIPPAGE_LIMIT=0.05

# Solver timeout in seconds
SOLVER_TIMEOUT_SECONDS=30

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable JSON logging for production
LOG_JSON=false

# =============================================================================
# EXECUTION MODE
# =============================================================================

# Set to 'paper' for paper trading, 'live' for real trading
TRADING_MODE=paper

# Private RPC endpoint for low-latency submission (optional)
PRIVATE_RPC_URL=
